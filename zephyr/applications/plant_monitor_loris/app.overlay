&spi3 {
  status = "okay";
  cs-gpios = <&gpio0 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

  sx1276: lora@0 {
    compatible = "semtech,sx1276";
    reg = <0>;

    reset-gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;

    // order of dio pins matters - idx 0 -> DIO0, idx 1 -> DIO1 and so on
    dio-gpios = <&gpio0 16 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>,
      <&gpio0 17 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
    spi-max-frequency = <1000000>;
    power-amplifier-output = "pa-boost";
  };
};


&adc0 {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@7 {
        reg = <7>;
        zephyr,gain = "ADC_GAIN_1_4";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
        zephyr,vref-mv = <1100>;
    };
};


&pinctrl {
  ledc0_default: ledc0_default {
    // function led green
    group1 {
      pinmux =
        <LEDC_CH0_GPIO22>, // fn-led-green

        // In prod
        /* <LEDC_CH1_GPIO1>, // fn-led-yellow */
        /* <LEDC_CH2_GPIO3>, // fn-led-red */

        // When testing to keep UART
        <LEDC_CH1_GPIO25>, // fn-led-yellow
        <LEDC_CH2_GPIO26>, // fn-led-red

        <LEDC_CH3_GPIO15>, // info-led-red
        <LEDC_CH4_GPIO2>, // info-led-green
        <LEDC_CH5_GPIO4>; // info-led-blue
      output-enable;
    };
  };
};

&ledc0 {
  pinctrl-0 = <&ledc0_default>;
  pinctrl-names = "default";
  status = "okay";
  #address-cells = <1>;
  #size-cells = <0>;

  // function led green
  channel0@0 {
    reg = <0x0>;
    timer = <0>;
  };

  // function led yellow
  channel1@1 {
    reg = <0x1>;
    timer = <0>;
  };

  // function led red
  channel2@2 {
    reg = <0x2>;
    timer = <0>;
  };

  // info led red
  channel3@3 {
    reg = <0x3>;
    timer = <0>;
  };

  // info led green
  channel4@4 {
    reg = <0x4>;
    timer = <0>;
  };

  // info led blue
  channel5@5 {
    reg = <0x5>;
    timer = <0>;
  };
};

/ {
  leds {
    status = "disabled";
  };

  aliases {
    lora0 = &sx1276;

    fn-led-green = &fn_led_green;
    fn-led-yellow = &fn_led_yellow;
    fn-led-red = &fn_led_red;

    info-led-red = &info_led_red;
    info-led-green = &info_led_green;
    info-led-blue = &info_led_blue;

    env-temp-sensor = &env_ds18b20;
    soil-temp-sensor = &soil_ds18b20;
    w1 = &w1_bus;
    buzzer = &buzzer;
  };

  zephyr,user {
    io-channels = <&adc0 7>;
    io-channel-names = "moisture";
  };

  pwmleds {
    compatible = "pwm-leds";
    fn_led_green: fn_led_green {
      pwms = <&ledc0 0 10000 PWM_POLARITY_NORMAL>;
    };

    fn_led_yellow: fn_led_yellow {
      pwms = <&ledc0 1 10000 PWM_POLARITY_NORMAL>;
    };

    fn_led_red: fn_led_red {
      pwms = <&ledc0 2 10000 PWM_POLARITY_NORMAL>;
    };

    info_led_red: info_led_red {
      pwms = <&ledc0 3 10000 PWM_POLARITY_NORMAL>;
    };

    info_led_green: info_led_green {
      pwms = <&ledc0 4 10000 PWM_POLARITY_NORMAL>;
    };

    info_led_blue: info_led_blue {
      pwms = <&ledc0 5 10000 PWM_POLARITY_NORMAL>;
    };
  };

  buzzer: buzzer {
    compatible = "gpio-buzzer";
    gpios = <&gpio1 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
  };

  w1_bus: w1-bus {
    compatible = "zephyr,w1-gpio";
    // gpio1 is the second gpio controller, offset by 32, thus 
    // 33 (actual pin) - 32 -> 1
    gpios = <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
    status = "okay";

    env_ds18b20: env_ds18b20 {
      compatible = "maxim,ds18b20";
      family-code = <0x28>;
      resolution = <12>;
      status = "okay";
    };

    soil_ds18b20: soil_ds18b20 {
      compatible = "maxim,ds18b20";
      family-code = <0x28>;
      resolution = <12>;
      status = "okay";
    };
  };
};
