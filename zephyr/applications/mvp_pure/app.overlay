&adc0 {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@7 {
        reg = <7>;
        zephyr,gain = "ADC_GAIN_1_4";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
        zephyr,vref-mv = <1100>;
    };
};

/ {
  aliases {
    led-green = &led_green;
    led-yellow = &led_yellow;
    led-red = &led_red;
    env-temp-sensor = &env_ds18b20;
    w1 = &w1_bus;
    buzzer = &buzzer;
  };

  zephyr,user {
    io-channels = <&adc0 7>;
    io-channel-names = "moisture";
  };

  leds {
    compatible = "gpio-leds";
    led_green: led_0 {
      gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>;
    };
    led_yellow: led_1 {
      gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>;
    };
    led_red: led_2 {
      gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>;
    };
  };

  buzzer: buzzer {
    compatible = "gpio-buzzer";
    gpios = <&gpio1 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
  };

  w1_bus: w1-bus {
    compatible = "zephyr,w1-gpio";
    // gpio1 is the second gpio controller, offset by 32, thus 
    // 33 (actual pin) - 32 -> 1
    gpios = <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
    status = "okay";

    env_ds18b20: ds18b20 {
      compatible = "maxim,ds18b20";
      family-code = <0x28>;
      resolution = <12>;
      status = "okay";
    };
  };
};


