#!/usr/bin/env bash

SCRIPT_NAME="STARTUP"
TIMEOUT_SECS=20

get-timestamp() {
  date -u +"%Y-%m-%dT%H:%M:%S.%3NZ"
}

fatal() {
  echo "[$SCRIPT_NAME] $(get-timestamp) FATAL" "$@" >&2
  exit 1
}

info() {
  echo "[$SCRIPT_NAME] $(get-timestamp) INFO" "$@"
}

if [[ -z "$MQTT_BROKER_ADDR" ]]; then
  fatal "Missing env var 'MQTT_BROKER_ADDR'"
fi

envsubst < ./configs/forwarder.template.toml > ./configs/forwarder.toml

info "Starting concentratord..."
./chirpstack-concentratord-sx1302 -c ./configs/concentratord.toml | sed -u 's/^/[CONCENTRATORD] /' &

info "Waiting for concentratord to initialize the TCP socket..."
while [[ ! -S /tmp/concentratord_event ]]; do
  if [[ $TIMEOUT_SECS -le 0 ]]; then
    fatal "Concentratord timed out"
  fi

  sleep 1
  TIMEOUT_SECS=$((TIMEOUT_SECS - 1))
done

info "Starting mqtt-forwarder..."
./chirpstack-mqtt-forwarder -c ./configs/forwarder.toml | sed -u 's/^/[MQTT_FORWARDER] /' &

wait -n
