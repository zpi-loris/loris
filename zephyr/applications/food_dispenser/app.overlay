/ {
  aliases {
    lora0 = &sx1276;
  };

  servo: servo {
    compatible = "pwm-servo";
    pwms = <&mcpwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
    min-pulse = <PWM_USEC(500)>;
    max-pulse = <PWM_USEC(2500)>;
  };

  zephyr,user {
    io-channels = <&adc0 7>;
    io-channel-names = "weight";
  };
};


&spi3 {
  status = "okay";
  cs-gpios = <&gpio0 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

  sx1276: lora@0 {
    compatible = "semtech,sx1276";
    reg = <0>;

    reset-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;

    // order of dio pins matters - idx 0 -> DIO0, idx 1 -> DIO1 and so on
    dio-gpios = <&gpio0 16 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>,
      <&gpio0 17 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
    spi-max-frequency = <1000000>;
    power-amplifier-output = "pa-boost";
  };
};


&adc0 {
  status = "okay";
  #address-cells = <1>;
  #size-cells = <0>;

  channel@7 {
    reg = <7>;
    zephyr,gain = "ADC_GAIN_1_4";
    zephyr,reference = "ADC_REF_INTERNAL";
    zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
    zephyr,resolution = <12>;
    zephyr,vref-mv = <1100>;
  };
};


&pinctrl {
  mcpwm0_default: mcpwm0_default {
    group1 {
      pinmux = <MCPWM0_OUT0A_GPIO32>;
      output-enable;
    };
  };
};


&mcpwm0 {
  pinctrl-0 = <&mcpwm0_default>;
  pinctrl-names = "default";
  prescale = <0>;
  prescale-timer0 = <255>;
  status = "okay";
};
